{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "0.1.0",
  "identifier": "com.nadak.memo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memo",
        "width": 1000,
        "height": 680,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
